{
  "ConnectionStrings": {
    "Matloob": "Host=localhost;Port=54321;Database=matloob;Username=matloob;Password=matloob_dev_password"
  },
  "Identity": {
    "Authority": "https://host.docker.internal:44310",
    "Issuer": "https://localhost:44310",
    "Audience": "matloob:api",
    "AdminAudience": "matloob:admin",
    "RequireHttpsMetadata": false,
    "RoleClaimType": "role",
    "NameClaimType": "sub"
  },
  "Storage": {
    "Driver": "Local",
    "AssetsRoot": "./_assets"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
