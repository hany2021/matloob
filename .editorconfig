# EditorConfig — https://editorconfig.org
# Cross-IDE consistency for VS 2022, VS Code, Rider, and CLI tools.

root = true

# ----------------------------------------------------------------------------
# Defaults for every file
# ----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# ----------------------------------------------------------------------------
# C# / .NET
# ----------------------------------------------------------------------------
[*.{cs,csx,cake}]
indent_size = 4

# Encoding for VS-generated XML configs
[*.{csproj,vbproj,proj,projitems,shproj,vcxproj,vcxproj.filters,props,targets,ruleset,nuspec,resx}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{xml,xsd,xsl,xslt,wxs,wxl,wxi,plist,config,svg,html,htm,cshtml,razor}]
indent_size = 2

# ----------------------------------------------------------------------------
# Frontend (TypeScript / Angular / JS)
# ----------------------------------------------------------------------------
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

[*.{html,scss,sass,css,less}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# ----------------------------------------------------------------------------
# Docs / config
# ----------------------------------------------------------------------------
[*.md]
indent_size = 2
trim_trailing_whitespace = false   # markdown uses trailing spaces for line breaks

[*.{sh,ps1,bash}]
indent_size = 2

[Dockerfile*]
indent_size = 2

[Makefile]
indent_style = tab

# ----------------------------------------------------------------------------
# C# language-style rules (a small, safe defaults set;
# expand in Phase 2 with .editorconfig per-project rules)
# ----------------------------------------------------------------------------
[*.cs]
# Use file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# 'var' when type is apparent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 'this.' qualifier discouraged
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Prefer braces always
csharp_prefer_braces = true:warning

# Sort System.* usings first
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# Prefer expression-bodied members where natural
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
